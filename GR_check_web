<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>그린리모델링 인재양성 플랫폼 · 교과 이수 점검 (웹)</title>
<meta name="description" content="보관성적증명서를 읽어 GR 특성화 교과 24학점 이수 가능 여부를 점검합니다">
<link rel="preconnect" href="https://cdn.jsdelivr.net">
<link rel="stylesheet" as="style" crossorigin href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
<script src="https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/build/pdf.min.js"></script>
<style>
  :root{
    --paper:#FFFFFF; --ink:#1B1C17; --ink-soft:#666A5D; --ink-faint:#93968A;
    --line:#DEDEDA; --line-soft:#EDEDEA;
    --pine:#087263; --pine-dim:#065A4F; --pine-wash:#F0F6F4;
    --flag:#9A5B00; --flag-wash:#FBF5EC;
    --amber:#A8760B; --amber-wash:#FDF7EA; --amber-line:#E3CE9E;
    --gray-wash:#F5F5F2; --lack:#B23B32;
    --arch:#A4413C; --common:#C07A28; --eng:#2E5E96; --field:#2F6B4F;
    --mono: ui-monospace,'SF Mono','Menlo','Consolas',monospace;
  }
  *{box-sizing:border-box;}
  html{-webkit-text-size-adjust:100%;}
  body{margin:0;background:var(--paper);color:var(--ink);font-size:15px;line-height:1.6;
       font-family:'Pretendard Variable','Pretendard',-apple-system,BlinkMacSystemFont,'Malgun Gothic',sans-serif;
       -webkit-font-smoothing:antialiased;}
  a{color:var(--pine);}
  .wrap{max-width:1180px;margin:0 auto;padding:0 24px 80px;}
  :focus-visible{outline:2px solid var(--pine);outline-offset:2px;border-radius:3px;}

  header{padding:38px 20px 0;}
  .header-inner{max-width:1180px;margin:0 auto;}
  .eyebrow{font-family:var(--mono);font-size:11.5px;letter-spacing:.06em;color:var(--ink-faint);margin-bottom:14px;}
  h1.title{font-weight:800;font-size:23px;line-height:1.4;letter-spacing:-.01em;margin:0 0 10px;}
  h1.title .accent{color:var(--pine);}
  .lede{font-size:14px;color:var(--ink-soft);margin:0 0 22px;max-width:46em;}

  /* status */
  .status{position:sticky;top:0;z-index:10;background:var(--paper);padding:14px 0 12px;border-bottom:1px solid var(--line);}
  /* 기본 회색 → 판독 후 노랑 → 요건 충족 초록 */
  .gauge{border:1.5px solid var(--line);border-radius:9px;padding:14px 20px 16px;background:var(--gray-wash);
         transition:background .2s ease,border-color .2s ease;}
  @media (min-width:981px){
    .gval{font-size:36px;}
    .gval .goal{font-size:19px;}
    .gtop .glabel{font-size:13px;}
    .gtop .gstage{font-size:14px;}
    .bar{height:13px;gap:3px;}
    .gsub{font-size:12.5px;gap:18px;}
    h1.title{font-size:27px;}
    .lede{font-size:15px;}
  }
  .gtop{display:flex;align-items:baseline;justify-content:space-between;gap:10px;}
  .gtop .glabel{font-size:12px;font-weight:600;color:var(--ink-faint);}
  .gtop .gstage{font-size:13px;font-weight:700;color:var(--ink-faint);font-family:var(--mono);letter-spacing:-.01em;}
  .gval{font-family:var(--mono);font-size:31px;font-weight:700;letter-spacing:-.03em;line-height:1.15;
        margin-top:2px;color:var(--ink-soft);}
  .gval .goal{font-size:17px;color:var(--ink-faint);font-weight:500;}
  /* 24칸 — 한 칸이 1학점. 노랑은 GR기초, 초록은 GR심화, 연한 쪽은 수강 예정. */
  .bar{display:flex;gap:2px;height:11px;margin-top:10px;}
  .bar i{flex:1;background:#E2E2DE;border-radius:2px;}
  .bar i.bd{background:var(--amber);}
  .bar i.bp{background:#E0C894;}
  .bar i.ad{background:var(--pine);}
  .bar i.ap{background:#96C4B9;}
  .gtop .gstage .k{display:inline-block;width:8px;height:8px;border-radius:2px;margin-right:4px;
                   vertical-align:baseline;}
  .gtop .gstage .k.b{background:var(--amber);}
  .gtop .gstage .k.a{background:var(--pine);}

  .gauge.prog{border-color:var(--amber-line);background:var(--amber-wash);}
  .gauge.prog .gtop .glabel,.gauge.prog .gtop .gstage,.gauge.prog .gval{color:var(--amber);}
  .gauge.prog .gval .goal{color:#B99C63;}
  .gauge.prog .gsub{color:#96793E;}
  .gauge.prog .gsub b{color:var(--amber);}

  .gauge.met{border-color:var(--pine);background:var(--pine-wash);}
  .gauge.met .gtop .glabel,.gauge.met .gtop .gstage,.gauge.met .gval{color:var(--pine-dim);}
  .gauge.met .gval .goal{color:#7FA79E;}
  .gauge.met .gsub{color:#6E8C85;}
  .gauge.met .gsub b{color:var(--pine-dim);}
  .bar{height:4px;background:var(--line-soft);border-radius:2px;margin-top:8px;overflow:hidden;display:flex;}
  .bar i{display:block;height:100%;width:0;transition:width .2s ease;}
  .gsub{display:flex;gap:15px;margin-top:9px;font-family:var(--mono);font-size:12px;color:var(--ink-faint);flex-wrap:wrap;}
  .gsub b{font-weight:700;color:var(--ink-soft);}
  .status.compact{padding:8px 0;}
  .status.compact .gauge{padding:8px 13px 10px;}
  .status.compact .gval{font-size:20px;}
  .status.compact .gval .goal{font-size:13px;}
  .status.compact .bar{margin-top:6px;}
  .status.compact .gsub{display:none;}
  section{margin-top:34px;scroll-margin-top:130px;}

  /* 넓은 화면에서는 입력을 왼쪽, 결과를 오른쪽에 둔다. */
  .cols{display:grid;grid-template-columns:minmax(380px, 440px) minmax(0, 1fr);gap:34px;align-items:start;}
  .colL > section:first-child,
  .colR > section:first-child{margin-top:26px;}
  .colR .verdict{margin-top:26px;}
  @media (max-width:980px){
    .cols{display:block;}
    .colR .verdict{margin-top:20px;}
  }

  /* verdict */
  .verdict{border:1.3px solid var(--line);border-radius:9px;padding:14px 15px 15px;margin:18px 0 4px;}
  .verdict.ok{border-color:var(--pine);background:var(--pine-wash);}
  .verdict.no{border-color:var(--flag);background:var(--flag-wash);}
  .verdict h2{font-size:15px;font-weight:700;margin:0 0 8px;}
  .verdict.ok h2{color:var(--pine-dim);}
  .verdict.no h2{color:var(--flag);}
  .verdict ul{margin:0;padding-left:17px;}
  .verdict li{font-size:13.5px;color:var(--ink-soft);margin-bottom:3px;line-height:1.55;}
  .verdict li b{color:var(--ink);font-weight:600;}
  .verdict li .lack{font-style:normal;color:var(--lack);font-weight:700;}
  .verdict .note{font-size:13.5px;font-weight:700;color:var(--ink);margin:10px 0 0;padding-top:9px;border-top:1px solid var(--line);line-height:1.6;}
  .verdict.ok .note{border-top-color:#CBE0DA;color:var(--ink);}
  .verdict.no .note{border-top-color:#EFE3D2;color:var(--ink);}

  h2.sec{font-size:16px;font-weight:700;margin:0 0 4px;display:flex;align-items:baseline;gap:8px;}
  h2.sec .req{font-family:var(--mono);font-size:12px;font-weight:500;color:var(--ink-faint);}
  .sec-note{font-size:13px;color:var(--ink-soft);margin:0 0 14px;}

  /* import */
  .guide{border:1.3px solid var(--line);border-radius:8px;padding:11px 13px 12px;margin-bottom:14px;background:#FAFAF8;}
  .guide .ghead{font-size:12.5px;font-weight:700;color:var(--ink-soft);margin-bottom:8px;}
  .gsteps{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;align-items:center;gap:7px;counter-reset:g;}
  .gsteps li{display:flex;align-items:center;gap:6px;font-size:13px;line-height:1.5;}
  .gsteps li::before{counter-increment:g;content:counter(g);font-family:var(--mono);font-size:10px;
                     width:16px;height:16px;border-radius:50%;background:var(--pine-wash);color:var(--pine-dim);
                     display:flex;align-items:center;justify-content:center;font-weight:700;flex-shrink:0;}
  .gsteps li:not(:last-child)::after{content:'›';color:var(--ink-faint);font-size:15px;margin-left:1px;}
  .guide .gshot{display:block;width:100%;height:auto;margin:10px 0 0;
                border:1px solid var(--line);border-radius:6px;background:#fff;cursor:zoom-in;}
  .guide .gshot.zoom{position:fixed;inset:24px;width:auto;height:auto;max-width:calc(100% - 48px);
                     max-height:calc(100% - 48px);margin:auto;z-index:50;cursor:zoom-out;
                     box-shadow:0 10px 40px rgba(0,0,0,.25);}
  .guide .gnote{font-size:14px;font-weight:700;color:var(--ink);line-height:1.7;margin:11px 0 0;}
  .drop{display:flex;flex-direction:column;align-items:center;gap:5px;border:1.3px dashed var(--line);
        border-radius:9px;padding:24px 18px;cursor:pointer;text-align:center;
        transition:border-color .15s ease,background .15s ease;}
  .drop:hover,.drop.over{border-color:var(--pine);background:var(--pine-wash);}
  .drop .dmain{font-size:14px;font-weight:600;}
  .drop .dsub{font-size:12.5px;color:var(--ink-faint);}
  .drop.busy{pointer-events:none;opacity:.6;}
  .srcnote{border:1.3px solid var(--flag);background:var(--flag-wash);border-radius:8px;
           padding:11px 13px;margin-top:14px;font-size:13px;color:var(--ink-soft);line-height:1.6;}
  .srcnote b{color:var(--flag);font-weight:700;}
  .rowtab{border:1.3px solid var(--line);border-radius:8px;overflow:hidden;margin-top:8px;}
  .rrow{display:flex;align-items:center;gap:9px;padding:7px 10px;
        border-bottom:1px solid var(--line-soft);font-size:13.5px;}
  .rrow:last-child{border-bottom:none;}
  .rrow.on{background:var(--pine-wash);}
  .rrow.fail{opacity:.45;}
  .rrow.dup{opacity:.55;}
  .rrow.gstart{border-top:1.5px solid var(--line);}
  .rowhead{display:flex;align-items:center;gap:9px;padding:7px 10px;background:#F5F5F2;
           border-bottom:1.3px solid var(--line);font-family:var(--mono);font-size:11px;color:var(--ink-faint);}
  .rowhead .rt{width:60px;flex-shrink:0;}
  .rowhead .rn{flex:1;}
  .rowhead .rc{flex-shrink:0;}
  .rowhead .rx{width:88px;text-align:right;flex-shrink:0;}
  .rrow .rn em.dupe{color:var(--flag);background:var(--flag-wash);}
  .rrow .rt{font-family:var(--mono);font-size:11.5px;color:var(--ink-faint);width:60px;flex-shrink:0;}
  .rrow .rn{flex:1;line-height:1.4;min-width:0;}
  .rrow .rn em{font-style:normal;font-family:var(--mono);font-size:10.5px;color:var(--pine-dim);
               background:var(--pine-wash);padding:1px 5px;border-radius:4px;margin-left:5px;}
  .rrow .rc{font-family:var(--mono);font-size:11.5px;color:var(--ink-faint);flex-shrink:0;}
  .rrow .rx{font-family:var(--mono);font-size:11px;color:var(--ink-faint);flex-shrink:0;width:88px;text-align:right;}
  .rrow.on .rx{color:var(--pine-dim);}
  @media (max-width:560px){
    .rrow{flex-wrap:wrap;}
    .rrow .rn{flex:1 1 100%;order:-1;}
    .rrow .rx{width:auto;}
  }
  .summary{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-top:14px;}
  .summary div{border:1.3px solid var(--line);border-radius:7px;padding:7px 9px 9px;}
  .summary .k{font-size:11px;color:var(--ink-faint);line-height:1.35;}
  .summary .v{font-family:var(--mono);font-size:17px;font-weight:600;margin-top:1px;}
  .summary .v.flagv{color:var(--flag);}

  .field{margin-top:18px;}
  .fhead{display:flex;justify-content:space-between;align-items:baseline;gap:10px;padding-bottom:5px;
         border-bottom:1px solid var(--line);margin-bottom:8px;}
  .fhead .fname{font-size:12.5px;font-weight:600;color:var(--ink-soft);}
  .fhead .fval{font-family:var(--mono);font-size:12px;color:var(--ink-faint);}
  .chips{display:flex;flex-wrap:wrap;gap:5px;}
  .chip{font-family:var(--mono);font-size:12px;border:1.3px solid var(--line);border-radius:6px;
        padding:4px 9px;background:#fff;cursor:pointer;color:var(--ink-soft);font-weight:500;}
  .chip:hover{border-color:var(--pine);}
  .chip.on{border-color:var(--pine);background:var(--pine-wash);color:var(--pine-dim);}
  .chip .n{color:var(--ink-faint);font-size:10.5px;margin-left:4px;}
  .chip.on .n{color:var(--pine);}
  .chip.flat{cursor:default;}
  .chip.flat:hover{border-color:var(--line);}
  .chip.flat.on:hover{border-color:var(--pine);}
  .trow .tk .cut{font-family:var(--mono);font-size:11px;color:var(--ink-faint);margin-left:5px;}
  .hint{font-size:12.5px;color:var(--ink-faint);margin-top:7px;line-height:1.55;}
  .blist{list-style:none;margin:0;padding:0;}
  .sec-note.blist{margin:0 0 15px;}
  .hint.blist{margin:8px 0 0;}
  .srcnote .blist{margin:5px 0 0;}
  .blist li{position:relative;padding-left:13px;margin-bottom:2px;}
  .blist li:last-child{margin-bottom:0;}
  .blist li::before{content:'·';position:absolute;left:3px;top:-1px;font-weight:700;}
  .majorbox{border:1.4px solid var(--line);border-radius:9px;padding:11px 13px 12px;background:#FCFCFB;}
  .majorbox .chips{margin-bottom:2px;}
  .chip.plain{font-family:inherit;font-size:13.5px;font-weight:700;padding:7px 15px;}
  .chip.m-arch.on{border-color:var(--arch);background:#FBF1F0;color:var(--arch);}
  .chip.m-eng.on{border-color:var(--eng);background:#EEF2F8;color:var(--eng);}
  .chip.m-arch:hover{border-color:var(--arch);}
  .chip.m-eng:hover{border-color:var(--eng);}

  .maybe{border:1.3px solid var(--flag);background:var(--flag-wash);border-radius:8px;padding:12px 13px;margin-top:16px;}
  .maybe h3{font-size:13.5px;font-weight:700;margin:0 0 3px;color:var(--flag);}
  .maybe p{font-size:12.5px;color:var(--ink-soft);margin:0 0 9px;line-height:1.55;}
  .mrow{display:flex;align-items:center;gap:9px;padding:6px 0;border-top:1px solid #EFE3D2;}
  .mrow .mn{flex:1;font-size:13.5px;line-height:1.4;}
  .mrow .mn em{font-style:normal;color:var(--ink-faint);font-size:12px;}
  .mrow button{border:1.3px solid var(--line);background:#fff;border-radius:6px;padding:3px 9px;
               font-family:inherit;font-size:12.5px;cursor:pointer;color:var(--ink-soft);flex-shrink:0;}
  .mrow button:hover{border-color:var(--pine);color:var(--pine);}
  .mrow button.done{border-color:var(--pine);background:var(--pine-wash);color:var(--pine-dim);}
  details.rest{margin-top:14px;}
  details.rest summary{font-size:13px;color:var(--ink-faint);cursor:pointer;padding:4px 0;}
  details.rest summary:hover{color:var(--ink);}
  .restlist{font-family:var(--mono);font-size:12px;color:var(--ink-faint);line-height:1.9;padding-top:4px;}

  /* tally */
  .tally{border:1.3px solid var(--line);border-radius:8px;overflow:hidden;}
  .trow{display:flex;align-items:baseline;gap:10px;padding:9px 13px;border-bottom:1px solid var(--line-soft);}
  .trow:last-child{border-bottom:none;}
  .trow .tk{flex:1;font-size:13.5px;}
  .trow .tk em{font-style:normal;color:var(--ink-faint);font-size:12px;display:block;line-height:1.5;margin-top:1px;}
  .trow .tv{font-family:var(--mono);font-size:14px;font-weight:600;flex-shrink:0;}
  .trow.sum{background:#F7F7F5;}
  .trow.dim .tk,.trow.dim .tv{color:var(--ink-faint);}

  /* path */
  .term-block{margin-bottom:20px;}
  .term-head{width:100%;display:flex;align-items:baseline;gap:8px;
             padding:6px 2px 6px 0;border:none;background:none;border-bottom:1px solid var(--line);
             margin-bottom:4px;cursor:pointer;font-family:inherit;text-align:left;}
  .term-head .tarrow{font-size:10px;color:var(--ink-faint);flex-shrink:0;
                     transition:transform .15s ease;display:inline-block;}
  .term-block.open .term-head .tarrow{transform:rotate(90deg);}
  .term-head .tname{font-size:13px;font-weight:700;flex:1;}
  .term-head:hover .tname{color:var(--pine-dim);}
  .term-head .tmeta{font-family:var(--mono);font-size:11.5px;color:var(--ink-faint);flex-shrink:0;}
  .term-body{display:none;}
  .term-block.open .term-body{display:block;}
  .cw{display:flex;align-items:center;gap:10px;padding:7px 2px 7px 11px;border-bottom:1px solid var(--line-soft);
      border-left:3px solid var(--line);cursor:pointer;}
  .cw:last-child{border-bottom:none;}
  .cw.dash{border-left-style:dashed;}
  .cw.tr-arch{border-left-color:var(--arch);}
  .cw.tr-common{border-left-color:var(--common);}
  .cw.tr-eng{border-left-color:var(--eng);}
  .cw.tr-field{border-left-color:var(--field);}
  .cw .cn{flex:1;font-size:14.5px;line-height:1.4;}
  .cw .cm{font-family:var(--mono);font-size:11px;color:var(--ink-faint);line-height:1.5;display:block;margin-top:1px;}
  .cw .cm b{font-weight:700;color:var(--ink-soft);}
  .cw .cs{font-family:var(--mono);font-size:11px;padding:2px 7px;border-radius:5px;flex-shrink:0;
          background:#F4F4F1;color:var(--ink-faint);}
  .cw.done .cs{background:var(--amber);color:#fff;}
  .cw.done .cn{font-weight:600;}
  .cw.planned{background:var(--amber-wash);}
  .cw.planned .cs{background:var(--amber-wash);color:var(--amber);border:1px solid var(--amber-line);}
  .cw.planned .cn{font-weight:600;color:var(--amber);}
  /* 24학점을 채우면 초록으로 */
  .fulfilled .cw.done .cs{background:var(--pine);}
  .fulfilled .cw.planned{background:var(--pine-wash);}
  .fulfilled .cw.planned .cs{background:var(--pine-wash);color:var(--pine-dim);border-color:var(--pine);}
  .fulfilled .cw.planned .cn{color:var(--pine-dim);}
  .fulfilled .cw.warn .cs{background:var(--flag-wash);color:var(--flag);}
  .cw.locked{cursor:default;opacity:.45;}
  .cw.req{cursor:default;}
  .cw.req .cs{font-weight:700;}
  .cw.locked .cn{font-weight:400;}
  .cw.warn .cs{background:var(--flag-wash);color:var(--flag);}
  .mark{font-family:var(--mono);font-size:10.5px;color:var(--flag);margin-left:4px;}
  .mark.late{background:#F2F2EE;color:var(--ink-faint);padding:1px 5px;border-radius:4px;}
  .legend{display:flex;flex-wrap:wrap;gap:12px;font-size:11.5px;color:var(--ink-faint);margin-bottom:14px;}
  .legend span{display:flex;align-items:center;gap:5px;}
  .legend i{width:9px;height:9px;border-radius:2px;display:block;}
                padding:6px 11px;cursor:pointer;color:var(--ink-soft);}
  .gate{display:flex;gap:8px;font-size:13px;padding:9px 11px;border-radius:7px;background:#F7F7F5;
        color:var(--ink-soft);margin-top:10px;line-height:1.5;}
  .gate.met{background:var(--pine-wash);color:var(--pine-dim);}
  .gate .gm{font-family:var(--mono);font-size:11.5px;flex-shrink:0;
            background:#EDEDEA;color:var(--ink-soft);padding:1px 7px;border-radius:5px;line-height:1.5;}
  .gate.met .gm{background:#D7E8E2;color:var(--pine-dim);}
  .empty{font-size:13px;color:var(--ink-faint);padding:16px 0;text-align:center;}
  .gated{display:none;}
  .gated.on{display:block;}

  /* review */

  footer{margin-top:52px;padding-top:22px;border-top:1px solid var(--line);}
  footer p{font-size:13px;color:var(--ink-soft);line-height:1.75;margin:0 0 12px;}
  footer .blist{font-size:13px;color:var(--ink-soft);line-height:1.75;margin:0 0 12px;}
  footer .meta{font-family:var(--mono);font-size:11px;color:var(--ink-faint);letter-spacing:.05em;}
  .reset{margin-top:24px;border:none;background:none;font-family:inherit;font-size:13px;color:var(--ink-faint);
         cursor:pointer;padding:4px 0;text-decoration:underline;text-underline-offset:3px;}
  .reset:hover{color:var(--ink);}

  @media (max-width:470px){
    .summary{grid-template-columns:repeat(2,1fr);}
    }
  @media (prefers-reduced-motion:reduce){*{transition:none !important;}}
</style>
</head>
<body>

<header>
  <div class="header-inner">
