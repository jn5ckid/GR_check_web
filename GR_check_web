function withTimeout(promise, ms, label){
  let t;
  return Promise.race([
    promise,
    new Promise(function(_, rej){
      t = setTimeout(function(){ rej(new Error(label + ' 응답이 ' + Math.round(ms/1000) + '초 안에 오지 않았습니다')); }, ms);
    })
  ]).finally(function(){ clearTimeout(t); });
}

async function loadTesseract(){
  if(window.Tesseract) return;
  await new Promise(function(res, rej){
    const el = document.createElement('script');
    el.src = TESS_CDN + 'tesseract.min.js';
    el.onload = res;
    el.onerror = function(){ rej(new Error('스크립트를 내려받지 못했습니다 (' + el.src + ')')); };
    document.head.appendChild(el);
  });
  if(!window.Tesseract) throw new Error('스크립트는 받았지만 Tesseract 객체가 없습니다');
}

/* 경로를 지정해 만들어 보고, 실패하면 기본값으로 한 번 더 시도한다. */
async function makeWorker(note){
  const logger = function(m){
    if(m.status === 'recognizing text') note('글자 판독 중 ' + Math.round(m.progress * 100) + '%');
    else if(m.status === 'loading language traineddata') note('한국어 모델 받는 중');
    else if(m.status) note('판독 준비 중');
  };
  try{
    return await withTimeout(window.Tesseract.createWorker('kor', 1, {
      logger:logger, workerPath:TESS_CDN + 'worker.min.js', corePath:TESS_CORE, langPath:TESS_LANG
    }), 90000, '판독 모듈');
  }catch(e1){
    try{
      return await withTimeout(window.Tesseract.createWorker('kor', 1, {logger:logger}), 90000, '판독 모듈(기본 경로)');
    }catch(e2){
      throw new Error('지정 경로 — ' + (e1 && e1.message || e1) + ' / 기본 경로 — ' + (e2 && e2.message || e2));
    }
  }
}

/* 표 괘선을 지운다.
   판독기가 셀 경계선을 글자로 오인해 행이 통째로 깨지는 것을 막는다.
   가로 · 세로로 길게 이어진 어두운 줄만 지우므로 글자는 남는다. */
function stripRules(cx, w, h){
  const img = cx.getImageData(0, 0, w, h);
  const d = img.data;
  const dark = new Uint8Array(w * h);
  for(let i = 0, q = 0; q < dark.length; i += 4, q++){
    dark[q] = (d[i] * 0.299 + d[i+1] * 0.587 + d[i+2] * 0.114) < 128 ? 1 : 0;
  }
  const rowCut = w * 0.5, colCut = h * 0.5;
  for(let y = 0; y < h; y++){
    let n = 0; const base = y * w;
    for(let x = 0; x < w; x++) n += dark[base + x];
    if(n > rowCut) for(let x = 0; x < w; x++){ const i = (base + x) * 4; d[i] = d[i+1] = d[i+2] = 255; }
  }
  for(let x = 0; x < w; x++){
    let n = 0;
    for(let y = 0; y < h; y++) n += dark[y * w + x];
    if(n > colCut) for(let y = 0; y < h; y++){ const i = (y * w + x) * 4; d[i] = d[i+1] = d[i+2] = 255; }
  }
  cx.putImageData(img, 0, 0);
}

async function ocrPdf(file, note){
  ocrStage = '판독 모듈 내려받기';
  note('판독 모듈 내려받는 중');
  await loadTesseract();

  ocrStage = '판독 작업자 생성';
  note('판독 준비 중');
  const worker = await makeWorker(note);
  /* 괘선을 지운 뒤에는 단일 블록(psm 6)으로 읽어야 행이 유지된다.
     자동 배치 분석에 맡기면 표의 열을 따로 읽어 행이 무너진다. */
  await worker.setParameters({tessedit_pageseg_mode:'6'});

  const buf = await file.arrayBuffer();
  const doc = await window.pdfjsLib.getDocument({data:new Uint8Array(buf)}).promise;
  let text = '';
  try{
    for(let p = 1; p <= doc.numPages; p++){
      ocrStage = p + '쪽 이미지 변환';
      note(doc.numPages > 1 ? p + '/' + doc.numPages + '쪽 변환 중' : '이미지로 변환 중');
      const page = await doc.getPage(p);
      let scale = 250 / 72;
      const base = page.getViewport({scale:1});
      if(base.width * scale > 3000) scale = 3000 / base.width;   /* 메모리 상한 */
      const vp = page.getViewport({scale:scale});
      const cv = document.createElement('canvas');
      cv.width = Math.round(vp.width); cv.height = Math.round(vp.height);
      const cx = cv.getContext('2d', {willReadFrequently:true});
      cx.fillStyle = '#fff'; cx.fillRect(0, 0, cv.width, cv.height);
      await page.render({canvasContext:cx, viewport:vp}).promise;
      stripRules(cx, cv.width, cv.height);

      ocrStage = p + '쪽 글자 판독';
      const out = await withTimeout(worker.recognize(cv), 180000, p + '쪽 판독');
      text += '\n' + out.data.text;
      cv.width = cv.height = 0;
    }
  }finally{ try{ await worker.terminate(); }catch(e){} }
  ocrStage = '';
  return text;
}

function matchCourse(name){
  const k = NORM(name);
  if(!k) return {kind:'none'};
  for(let i = 0; i < INDEX.length; i++) if(INDEX[i].key === k) return {kind:'exact', c:INDEX[i].c};
  return {kind:'none'};
}

function ingest(rows){
  /* 판독 오류로 생긴 엉뚱한 연도를 걸러낸다.
     한 사람의 재학 기간은 아무리 길어도 10년을 넘지 않는다. */
  if(rows.length){
    let maxY = 0;
    rows.forEach(function(r){ if(r.year > maxY) maxY = r.year; });
    rows = rows.filter(function(r){ return maxY - r.year <= 9; });
  }
  state.rows = rows; state.dup = {};
  state.done = {}; state.plan = {};

  /* 여름 · 겨울은 계절학기이므로 이수 학기 수와 학년 산정에서 뺀다.
     계절학기에 이수한 과목의 학점은 그대로 인정한다. */
  const seen = {};
  let maxRank = 0;
  rows.forEach(function(r){
    const rk = rowRank(r);
    if(rk > maxRank) maxRank = rk;
    if(semRank(r.sem) === 1 || semRank(r.sem) === 2) seen[r.year + '-' + r.sem] = true;
  });
  state.maxRank = maxRank;
  state.terms = Object.keys(seen).map(function(key){
    const q = key.split('-');
    return {key:key, year:+q[0], sem:q[1], rank:absIdx(+q[0], q[1]) * 10 + semRank(q[1])};
  }).sort(function(a,b){ return a.rank - b.rank; });


  rebuildDone();
  inferOffset();
  applySplit();
}

/* 자동 대조 결과에 사용자가 지정한 대응을 덮어쓴다. */
function mappedName(i){
  const m = matchCourse(state.rows[i].name);
  return m.kind === 'exact' ? m.c.n : null;
}
function rowRank(r){ return absIdx(r.year, r.sem) * 10 + semRank(r.sem); }

/* 재수강은 같은 과목이 두 줄로 나온다(비고에 서로의 학기가 적힌다).
   같은 과목 중 한 줄만 인정한다 — 이수한 줄을 우선하고, 둘 다 이수면 나중 학기를 쓴다. */
function rebuildDone(){
  state.done = {}; state.dup = {};
  const best = {};
  state.rows.forEach(function(r, i){
    const mapped = mappedName(i);
    const key = mapped || ('~' + NORM(r.name));
    if(key === '~') return;
    const prev = best[key];
    if(prev === undefined){ best[key] = i; return; }
    const pr = state.rows[prev];
    const win = (r.passed && !pr.passed) ||
                (r.passed === pr.passed && rowRank(r) >= rowRank(pr));
    if(win){ state.dup[prev] = true; best[key] = i; }
    else { state.dup[i] = true; }
  });
  Object.keys(best).forEach(function(key){
    if(key.charAt(0) === '~') return;
    const r = state.rows[best[key]];
    if(!r.passed) return;
    state.done[key] = {term:r.year + '-' + r.sem, before:false};
  });
}

/* 학년은 이수한 정규학기 수로 센다. 2개 학기가 1개 학년이다.
   계절학기와 재수강은 학기 수에 넣지 않으므로 휴학이 있어도 어긋나지 않는다. */
function inferOffset(){
  state.offset = state.terms.length ? 0 : null;
  state.curNom = state.terms.length ? state.terms.length - 1 : null;
}
function nomOf(i){ return {y:Math.floor(i / 2) + 1, t:i % 2 + 1}; }

/* 소급 기준선 — 2026학년도 1학기까지 이수한 과목이 소급 대상,
   2026학년도 2학기부터는 그대로 인정한다. */
const CUTOFF = '2026-2';

function termRank(key){
  const q = String(key).split('-');
  if(q.length < 2) return 0;
  return absIdx(+q[0], q[1]) * 10 + semRank(q[1]);
}
function applySplit(){
  const cut = termRank(CUTOFF);
  Object.keys(state.done).forEach(function(n){
    state.done[n].before = termRank(state.done[n].term) < cut;
  });
}

/* ============================================================
   4. 계산
   ============================================================ */
function crOf(c){ return c.cr; }
/* 계열 전용 과목도 교차 이수 가능 — 전공과 무관하게 모두 담을 수 있다. */
function visible(c){ return true; }
/* 교과목은 해마다 같은 학기에 열린다.
   따라서 이전 학년 과목이라도 남은 학기 중 학기(1·2)가 맞으면 수강할 수 있다.
   예를 들어 3학년 1학기 과목은 4학년 1학기에 들을 수 있고,
   4학년 1학기를 마친 4년제 학생은 2학기만 남아 1학기 과목을 들을 수 없다. */
function lastNom(){ return state.major === 'arch' ? 9 : 7; }   /* 5년제 10학기, 4년제 8학기 */
function offerable(c){
  if(state.curNom === null) return true;
  const want = nomIdx(c.term) % 2;
  for(let i = state.curNom + 1; i <= lastNom(); i++) if(i % 2 === want) return true;
  return false;
}
/* 원래 배치보다 늦게 듣게 되는 과목 */
function offSequence(c){
  return state.curNom !== null && nomIdx(c.term) <= state.curNom;
}
function selectable(c){ return visible(c) && !state.done[c.n] && offerable(c); }

/* 전공을 고르면 그 전공의 전공필수는 선택이 아니라 반드시 듣는 과목이다. */
const MAJOR_LABEL = {arch:'건축학 (5년제)', eng:'건축공학 (4년제)'};
function required(c){
  if(state.major !== 'arch' && state.major !== 'eng') return false;
  if(c.req !== '전공필수') return false;
  if(c.track === 'common') return !c.reqOf || c.reqOf === state.major;
  return c.track === state.major;
}
/* 전공을 바꾸면 이전 전공 때문에 자동으로 담겼던 과목을 걷어내고 다시 채운다. */
function syncRequired(){
  Object.keys(state.auto).forEach(function(n){ delete state.plan[n]; });
  state.auto = {};
  COURSES.forEach(function(c){
    if(required(c) && selectable(c)){ state.plan[c.n] = true; state.auto[c.n] = true; }
  });
}

function compute(){
  let bBefore = 0, bAfter = 0, aAfter = 0, aBefore = [];
  const mustHit = [];
  COURSES.forEach(function(c){
    const d = state.done[c.n];
    if(!d) return;
    if(c.gr === '기초'){ if(d.before) bBefore += crOf(c); else bAfter += crOf(c); }
    else { if(d.before) aBefore.push(c.n); else { aAfter += crOf(c); if(c.must) mustHit.push(c.n); } }
  });
  let bPlan = 0, aPlan = 0;
  COURSES.forEach(function(c){
    if(!state.plan[c.n]) return;
    if(c.gr === '기초') bPlan += crOf(c);
    else { aPlan += crOf(c); if(c.must) mustHit.push(c.n); }
  });

  const carry = Math.min(bBefore, 6);
  const basicDone = Math.min(carry + bAfter, 9);
  const basicAll = Math.min(carry + bAfter + bPlan, 9);
  const basicPlan = basicAll - basicDone;
  const basicWaste = (carry + bAfter + bPlan) - basicAll;

  const advDone = aAfter, advAll = aAfter + aPlan;
  const totalDone = basicDone + advDone;
  const totalAll = basicAll + advAll;

  /* 남은 과목을 모두 담았을 때의 상한 */
  let maxBasic = 0, maxAdv = 0, maxMust = false;
  COURSES.forEach(function(c){
    if(!selectable(c)) return;
    if(c.gr === '기초') maxBasic += crOf(c); else { maxAdv += crOf(c); if(c.must) maxMust = true; }
  });
  const ceilBasic = Math.min(carry + bAfter + maxBasic, 9);
  const ceilAdv = advDone + maxAdv;
  const ceilTotal = ceilBasic + ceilAdv;
  const mustPossible = mustHit.length > 0 || maxMust;

  return {
    carry:carry, bBefore:bBefore, bAfter:bAfter, bPlan:bPlan,
    basicDone:basicDone, basicAll:basicAll, basicPlan:basicPlan, basicWaste:basicWaste,
    advDone:advDone, advAll:advAll, advPlan:aPlan, aBefore:aBefore,
    totalDone:totalDone, totalAll:totalAll,
    mustHit:mustHit, mustPossible:mustPossible,
    ceilTotal:ceilTotal, ceilAdv:ceilAdv, ceilBasic:ceilBasic,
    ok: totalAll >= 24 && advAll >= 15 && mustHit.length > 0,
    feasible: ceilTotal >= 24 && ceilAdv >= 15 && mustPossible
  };
}

/* ============================================================
   5. 화면
   ============================================================ */
/* 24칸을 GR기초 이수 · 예정, GR심화 이수 · 예정 순으로 채운다. */
function renderBar(r){
  const seq = [['bd', r.basicDone], ['bp', r.basicPlan], ['ad', r.advDone], ['ap', r.advPlan]];
  const cells = [];
  seq.forEach(function(pair){
    for(let i = 0; i < pair[1] && cells.length < 24; i++) cells.push(pair[0]);
  });
  while(cells.length < 24) cells.push('');
  document.getElementById('bar').innerHTML =
    cells.map(function(c){ return '<i class="' + c + '"></i>'; }).join('');
}

function paint(){
  syncRequired();
  const r = compute();
  const ready = state.rows.length;

  document.getElementById('gval').textContent = r.totalAll;
  document.getElementById('gstage').innerHTML =
    '<i class="k b"></i>GR기초 ' + r.basicAll + ' · <i class="k a"></i>GR심화 ' + r.advAll;
  renderBar(r);
  document.getElementById('sDone').textContent = r.totalDone;
  document.getElementById('sPlan').textContent = r.totalAll - r.totalDone;
  document.getElementById('sNeed').textContent = Math.max(0, 24 - r.totalAll);
  const gEl = document.getElementById('gauge');
  gEl.classList.toggle('prog', !!ready && !r.ok);
  gEl.classList.toggle('met', r.ok);
  document.body.classList.toggle('fulfilled', r.ok);

  /* 판정 */
  const v = document.getElementById('verdict');
  v.className = 'verdict';
  if(!ready){
    v.innerHTML = '<h2>보관성적증명서를 올려 주세요</h2><ul>' +
      '<li>이수한 과목을 읽어 인정 학점과 남은 요건을 계산합니다.</li></ul>';
  }else if(r.ok){
    v.className = 'verdict ok';
    v.innerHTML = '<h2>교과 24학점 요건 충족</h2><ul>' +
      '<li>GR기초 <b>' + r.basicAll + '학점</b> · GR심화 <b>' + r.advAll + '학점</b>, 필수 교과목 ' +
      r.mustHit.map(function(n){ return '「' + n + '」'; }).join(', ') + ' 포함.</li>' +
      (r.totalAll > r.totalDone ? '<li>수강 예정으로 담은 과목이 포함된 결과입니다.</li>' : '') +
      '</ul><p class="note">Silver 이상은 비교과 15크레딧이 추가로 필요합니다. 이 도구에서는 다루지 않습니다.</p>';
  }else{
    const gaps = [];
    if(r.advAll < 15) gaps.push('GR심화 <b>' + (15 - r.advAll) + '학점</b> <em class="lack">부족</em>');
    if(r.totalAll < 24) gaps.push('합계 <b>' + (24 - r.totalAll) + '학점</b> <em class="lack">부족</em>');
    if(!r.mustHit.length) gaps.push('필수 교과목 <em class="lack">미확보</em> — <b>「그린리모델링」 또는 「건축시스템설계」</b> 중 1과목');
      if(r.basicWaste > 0) gaps.push('GR기초 <b>' + r.basicWaste + '학점</b>은 9학점 한도를 넘어 <em class="lack">인정되지 않습니다</em>');
    if(!r.feasible){
      v.className = 'verdict no';
      const why = [];
      if(r.ceilAdv < 15) why.push('남은 학기에 열리는 GR심화 과목을 모두 담아도 ' + r.ceilAdv + '학점');
      if(r.ceilTotal < 24) why.push('상한이 ' + r.ceilTotal + '학점');
      if(!r.mustPossible) why.push('필수 교과목이 남은 학기에 없음');
      v.innerHTML = '<h2>현재 조건으로는 24학점을 채울 수 없습니다</h2><ul>' +
        why.map(function(x){ return '<li>' + x + '</li>'; }).join('') +
        '</ul><p class="note">2026학년도 2학기부터 이수하는 과목만 GR심화로 인정됩니다.</p>';
    }else{
      v.innerHTML = '<h2>남은 요건</h2><ul>' + gaps.map(function(g){ return '<li>' + g + '</li>'; }).join('') +
        '</ul><p class="note">남은 과목을 모두 담으면 최대 ' + r.ceilTotal + '학점(GR심화 ' + r.ceilAdv + ')까지 가능합니다.</p>';
    }
  }

  ['secTally','secPath','reset'].forEach(function(id){
    document.getElementById(id).classList.toggle('on', !!ready);
  });
  renderTally(r);
  renderPath();

  const gm = document.getElementById('gateMust');
  gm.classList.toggle('met', r.mustHit.length > 0);
  gm.innerHTML = '<span class="gm">' + (r.mustHit.length ? '확보' : '미확보') + '</span><span>' +
    (r.mustHit.length
      ? '필수 교과목 ' + r.mustHit.map(function(n){ return '「' + n + '」'; }).join(', ')
      : '필수 교과목 없음 — 「그린리모델링」 또는 「건축시스템설계」 중 1과목') +
    '</span>';
}

function renderTally(r){
  const el = document.getElementById('tally');
  let h = '';
  h += row('소급 GR기초 <span class="cut">26-1까지</span>', '이수 ' + r.bBefore + '학점 중 6학점 한도', r.carry);
  h += row('GR기초 <span class="cut">26-2부터</span>', '한도 9학점까지, 잔여 ' + Math.max(0, 9 - r.carry) + '학점', r.bAfter + r.bPlan);
  h += row('GR심화', r.aBefore.length ? '26-1까지 이수한 ' + r.aBefore.length + '과목은 소급 불인정' : '소급 인정 없음', r.advAll);
  h += '<div class="trow sum"><span class="tk">인정 합계</span><span class="tv">' + r.totalAll + ' / 24</span></div>';
  el.innerHTML = h;

}

function row(k, sub, v){
  return '<div class="trow' + (v ? '' : ' dim') + '"><span class="tk">' + k +
         '<em>' + sub + '</em></span><span class="tv">' + v + '</span></div>';
}

function renderPath(){
  const el = document.getElementById('path');
  if(!state.rows.length){ el.innerHTML = '<p class="empty">보관성적증명서를 올리면 경로가 표시됩니다.</p>'; return; }
  let h = '';
  /* 이미 들은 과목은 따로 묶는다 — 학년-학기 칸에는 남은 과목만 남긴다. */
  const doneList = COURSES.filter(function(c){ return !!state.done[c.n]; })
    .sort(function(a, b){ return nomIdx(a.term) - nomIdx(b.term); });
  if(doneList.length){
    let nb = 0, na = 0, drop = 0;
    doneList.forEach(function(c){
      if(c.gr === '기초') nb++;
      else if(state.done[c.n].before) drop++;
      else na++;
    });
    if(state.tOpen['DONE'] === undefined) state.tOpen['DONE'] = false;
    h += '<div class="term-block' + (state.tOpen['DONE'] ? ' open' : '') + '">' +
         '<button type="button" class="term-head" data-tblock="DONE">' +
         '<span class="tarrow">▶</span><span class="tname">이수 완료</span>' +
         '<span class="tmeta">GR기초 ' + nb + '과목 · GR심화 ' + na + '과목' +
         (drop ? ' · 소급 제외 ' + drop + '과목' : '') + '</span></button>' +
         '<div class="term-body">';
    doneList.forEach(function(c){ h += courseRow(c); });
    h += '</div></div>';
  }
  TERMS.forEach(function(t){
    const list = COURSES.filter(function(c){ return c.term === t && visible(c) && !state.done[c.n]; });
    if(!list.length) return;
    let sum = 0;
    list.forEach(function(c){ if(state.plan[c.n]) sum += crOf(c); });
    const pickable = list.filter(function(c){ return selectable(c); }).length;
    if(state.tOpen[t] === undefined) state.tOpen[t] = pickable > 0;
    h += '<div class="term-block' + (state.tOpen[t] ? ' open' : '') + '">' +
         '<button type="button" class="term-head" data-tblock="' + t + '">' +
         '<span class="tarrow">▶</span><span class="tname">' + termLabel(t) + '</span>' +
         '<span class="tmeta">' + (sum ? '담은 ' + sum + '학점 · ' : '') +
         (pickable ? '담을 수 있는 ' + pickable + '과목'
                   : (list.length ? '수강 불가 ' + list.length + '과목' : '남은 과목 없음')) +
         '</span></button>' +
         '<div class="term-body">';
    list.forEach(function(c){ h += courseRow(c); });
    h += '</div></div>';
  });
  h += '<ul class="hint blist">' +
       '<li>계열 전용 과목도 교차 이수할 수 있어 전공과 무관하게 모두 담을 수 있습니다.</li>' +
       '<li>이수체계도상 5학년에는 특성화 교과목이 없습니다.</li></ul>';
  el.innerHTML = h;
}

function courseRow(c){
  const d = state.done[c.n];
  const planned = !!state.plan[c.n];
  const isReq = required(c) && !d;
  let cls = 'cw tr-' + c.track + (c.gr === '기초' ? ' dash' : ''), st = '담기', lock = false;
  if(d){
    if(c.gr === '심화' && d.before){ cls += ' done warn'; st = '26-1 이전'; }
    else { cls += ' done'; st = '이수 ' + d.term; }
    lock = true;
  }else if(!offerable(c)){ cls += ' locked'; st = '남은 학기 없음'; lock = true; }
  else if(isReq){ cls += ' planned req'; st = '전공필수'; lock = true; }
  else if(planned){ cls += ' planned'; st = '수강 예정'; }
  const marks = (c.star ? '<span class="mark">★</span>' : '') + (c.must ? '<span class="mark">◆</span>' : '') +
                (!d && offerable(c) && offSequence(c) ? '<span class="mark late">이전 학년</span>' : '');
  const meta = (d ? termLabel(c.term) + ' · ' : '') +
               ['공통','건축학','건축공학'][{common:0,arch:1,eng:2}[c.track]] +
               ' · ' + c.req + (c.reqOf ? '(' + (c.reqOf === 'arch' ? '건축학' : '건축공학') + ')' : '') +
               ' · <b>GR' + c.gr + '</b> ' + crOf(c) + '학점' + (c.note ? ' · ' + c.note : '');
  return '<div class="' + cls + '"' + (lock ? '' : ' data-pick="' + c.n + '" role="button" tabindex="0"') + '>' +
         '<span class="cn">' + c.n + marks + '<span class="cm">' + meta + '</span></span>' +
         '<span class="cs">' + st + '</span></div>';
}

/* ============================================================
   6. 판독 결과
   ============================================================ */
function renderImport(err){
  const box = document.getElementById('importResult');
  if(err){
    box.innerHTML = '<div class="maybe"><h3>파일을 읽지 못했습니다</h3><p>' + err + '</p></div>';
    return;
  }
  if(!state.rows.length){ box.innerHTML = ''; return; }

  let nb = 0, na = 0;
  Object.keys(state.done).forEach(function(n){
    const c = byName(n); if(!c) return;
    if(c.gr === '기초') nb++; else na++;
  });

  const noScore = state.rows.length && state.rows.every(function(r){ return r.score === null; });
  let h = '';
  if(noScore){
    h += '<div class="srcnote"><b>등급 · 평점 열이 없는 보관성적증명서입니다.</b>' +
         '<ul class="blist"><li>학점까지만 읽었으므로 미이수(F) 과목을 구분할 수 없습니다.</li>' +
         '<li>재수강 전 F를 받은 과목이 있으면 결과가 실제보다 높게 나올 수 있습니다.</li></ul></div>';
  }
  if(state.source === 'ocr'){
    h += '<div class="srcnote"><b>이미지 판독으로 읽었습니다.</b>' +
         '<ul class="blist"><li>글자를 그림에서 인식한 결과라 과목명이 틀릴 수 있습니다.</li>' +
         '<li>아래 목록에서 인식 결과가 맞는지 확인해 주세요.</li></ul></div>';
  }
  h += '<div class="summary">' +
    '<div><div class="k">인식 과목</div><div class="v">' + state.rows.length + '</div></div>' +
    '<div><div class="k">이수 학기</div><div class="v">' + state.terms.length + '</div></div>' +
    '<div><div class="k">GR기초 이수</div><div class="v">' + nb + '</div></div>' +
    '<div><div class="k">GR심화 이수</div><div class="v">' + na + '</div></div>' +
    '</div>';

  h += '<div class="field"><div class="fhead"><span class="fname">전공</span>' +
       '<span class="fval">' + (state.major ? MAJOR_LABEL[state.major] : '선택 필요') +
       '</span></div><div class="majorbox"><div class="chips">' +
       ['arch', 'eng'].map(function(k){
         return '<button type="button" class="chip plain m-' + k + (state.major === k ? ' on' : '') +
                '" data-major="' + k + '">' +
                {arch:'건축학 5년제', eng:'건축공학 4년제'}[k] + '</button>';
       }).join('') +
       '</div><ul class="hint blist">' +
       '<li>전공을 고르면 그 전공의 전공필수 교과목이 이수 경로에 자동으로 포함됩니다.</li>' +
       '<li>계열 전용 과목도 교차 이수할 수 있어 전공과 무관하게 모두 담을 수 있습니다.</li></ul></div></div>';

  h += '<div class="field"><div class="fhead"><span class="fname">이수 학기</span>' +
       '<span class="fval">' + (state.curNom !== null
         ? state.terms.length + '개 학기 이수 · ' + nomOf(state.curNom).y + '학년 ' + nomOf(state.curNom).t + '학기'
         : '학기 없음') + '</span></div><div class="chips">';
  const cut = termRank(CUTOFF);
  state.terms.forEach(function(t, i){
    const g = nomOf(i);
    h += '<span class="chip flat' + (t.rank >= cut ? ' on' : '') + '">' +
         t.year + '-' + t.sem + '<span class="n">' + g.y + '-' + g.t + '</span></span>';
  });
  h += '</div><ul class="hint blist">' +
       '<li>정규학기만 세어 두 학기를 한 학년으로 봅니다.</li>' +
       '<li>오른쪽의 작은 숫자가 학년-학기이고, 진하게 표시된 학기가 2026학년도 2학기 이후입니다.</li>' +
       '<li>여름 · 겨울 계절학기는 학기 수에 넣지 않지만 그때 이수한 과목의 학점은 인정됩니다.</li>' +
       '</ul></div>';

  /* 행별 인식 결과 확인 */
  const ndup = Object.keys(state.dup).length;
  /* 특성화 교과목으로 잡힌 행만 남기고 이수 학기 순으로 묶는다. */
  const hits = [];
  state.rows.forEach(function(r, i){
    const cur = mappedName(i);
    if(cur) hits.push({r:r, i:i, c:byName(cur)});
  });
  hits.sort(function(a, b){ return rowRank(a.r) - rowRank(b.r); });

  h += '<details class="rest"' + (state.source === 'ocr' ? ' open' : '') + '>' +
       '<summary>인식한 특성화 교과목 ' + hits.length + '개 확인' +
       (ndup ? ' · 재수강 중복 ' + ndup + '개' : '') + '</summary>' +
       '<div class="rowtab">' +
       '<div class="rowhead"><span class="rt">이수 학기</span><span class="rn">과목</span>' +
       '<span class="rc">학점</span><span class="rx">구분</span></div>';
  let prev = '';
  hits.forEach(function(x){
    const key = x.r.year + '-' + x.r.sem;
    const isDup = !!state.dup[x.i];
    h += '<div class="rrow' + (isDup ? ' dup' : ' on') + (key !== prev ? ' gstart' : '') + '">' +
         '<span class="rt">' + key + '</span>' +
         '<span class="rn">' + x.r.name + (isDup ? '<em class="dupe">재수강 중복</em>' : '') + '</span>' +
         '<span class="rc">' + x.c.cr + '</span>' +
         '<span class="rx">GR' + x.c.gr + '</span></div>';
    prev = key;
  });
  h += '</div><ul class="hint blist">' +
       '<li>이수체계도의 교과목명과 완전히 같을 때만 특성화 교과목으로 잡힙니다.</li>' +
       '<li>학점은 이수체계도에 표기된 값으로 계산하므로 증명서 판독값과 다를 수 있습니다.</li>' +
       (ndup ? '<li>같은 과목이 여러 번 나오면 한 줄만 계산에 넣습니다. 이수한 줄을 우선하고, 둘 다 이수면 나중 학기를 씁니다.</li>' : '') +
       '</ul></details>';

  box.innerHTML = h;
}

/* ============================================================
   7. 이벤트
   ============================================================ */
const fileInput = document.getElementById('file');
const drop = document.getElementById('drop');

async function handleFile(f){
  if(!f) return;
  if(!/\.pdf$/i.test(f.name) && f.type !== 'application/pdf'){ renderImport('PDF 파일만 읽을 수 있습니다.'); return; }
  if(!window.pdfjsLib){ renderImport('PDF 판독 모듈을 불러오지 못했습니다. 네트워크 연결을 확인해 주세요.'); return; }
  drop.classList.add('busy');
  const note = function(msg){ drop.querySelector('.dmain').textContent = msg; };
  note('읽는 중');
  try{
    const lines = await readPdf(f);
    let rows = parseText(lines.join('\n'));
    let src = 'text';
    if(!rows.length){
      note('문자 정보가 없어 이미지 판독으로 전환합니다');
      const text = await ocrPdf(f, note);
      rows = parseText(text);
      src = 'ocr';
    }
    if(!rows.length){
      renderImport('성적 행을 찾지 못했습니다. 표 형식이 다를 수 있습니다. 인쇄 대화상자에서 대상을 PDF로 저장으로 골라 다시 내려받아 주세요.');
    }else { state.source = src; ingest(rows); renderImport(null); }
  }catch(e){
    const m = String(e && e.message || e);
    const where = ocrStage ? '[' + ocrStage + '] ' : '';
    if(/Worker|blob:/i.test(m)){
      renderImport('브라우저가 판독 작업자(Worker) 생성을 막았습니다. 미리보기 화면이나 file:// 로 연 경우에 나타납니다. ' +
        '웹서버에 올린 정상 주소로 열어 주세요. ' + where + m);
    }else{
      renderImport('이미지 판독에 실패했습니다. ' + where + m);
    }
  }
  drop.classList.remove('busy'); drop.querySelector('.dmain').textContent = 'PDF 파일 선택';
  paint();
}
fileInput.addEventListener('change', function(e){ handleFile(e.target.files[0]); });
['dragenter','dragover'].forEach(function(ev){ drop.addEventListener(ev, function(e){ e.preventDefault(); drop.classList.add('over'); }); });
['dragleave','drop'].forEach(function(ev){ drop.addEventListener(ev, function(e){ e.preventDefault(); drop.classList.remove('over'); }); });
drop.addEventListener('drop', function(e){ handleFile(e.dataTransfer.files[0]); });

function pick(name){
  if(!name) return;
  state.plan[name] = !state.plan[name];
  paint();
}
document.addEventListener('click', function(e){
  if(e.target.classList && e.target.classList.contains('gshot')){
    e.target.classList.toggle('zoom'); return;
  }
  const mj = e.target.closest ? e.target.closest('[data-major]') : null;
  if(mj){ state.major = mj.getAttribute('data-major'); renderImport(null); paint(); return; }
  const tb = e.target.closest ? e.target.closest('[data-tblock]') : null;
  if(tb){ const k = tb.getAttribute('data-tblock'); state.tOpen[k] = !state.tOpen[k]; renderPath(); return; }
  const pk = e.target.closest ? e.target.closest('[data-pick]') : null;
  if(pk) pick(pk.getAttribute('data-pick'));
});
document.addEventListener('keydown', function(e){
  if(e.key !== 'Enter' && e.key !== ' ') return;
  const pk = e.target.closest ? e.target.closest('[data-pick]') : null;
  if(pk){ e.preventDefault(); pick(pk.getAttribute('data-pick')); }
});

document.getElementById('reset').addEventListener('click', function(){
  state.rows = []; state.terms = []; state.maxRank = 0; state.tOpen = {}; state.major = null; state.auto = {};
  state.offset = null; state.curNom = null; state.done = {}; state.plan = {};
  state.source = null; state.dup = {};
  fileInput.value = '';
  document.getElementById('importResult').innerHTML = '';
  paint();
  window.scrollTo({top:0, behavior:'smooth'});
});

const statusEl = document.querySelector('.status');
let ticking = false;
window.addEventListener('scroll', function(){
  if(ticking) return;
  ticking = true;
  window.requestAnimationFrame(function(){
    statusEl.classList.toggle('compact', window.scrollY > 240); ticking = false;
  });
}, {passive:true});

/* ============================================================
   9. 초기화
   ============================================================ */
if(window.pdfjsLib) window.pdfjsLib.GlobalWorkerOptions.workerSrc = PDFJS_BASE + 'build/pdf.worker.min.js';
paint();
</script>
