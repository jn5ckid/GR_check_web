/* ============================================================
   3. PDF 판독
   ============================================================ */
const GRADE = /^(A\+|A0|A|B\+|B0|B|C\+|C0|C|D\+|D0|D|F|P|NP|S|U|W|I)$/;
const FAIL  = /^(F|NP|U|W|I)$/;
const SEMRANK = {'1':1,'여름':1.5,'하계':1.5,'계절':1.5,'2':2,'겨울':2.5,'동계':2.5};
function semRank(s){ const v = SEMRANK[s]; if(v !== undefined) return v; const n = parseFloat(s); return isNaN(n) ? 9 : n; }
function nomIdx(term){ const p = term.split('-'); return (+p[0] - 1) * 2 + (+p[1] - 1); }
function absIdx(year, sem){ return year * 2 + (semRank(sem) >= 2 ? 1 : 0); }

/* 교과목-분반. 판독 과정에서 분반이 떨어져 번호만 남는 경우도 받는다. */
const CODE  = /^([A-Z0-9]{3,}-[A-Z0-9]{1,3}|[0-9]{5,})$/i;

/* 학기 표기를 정규화한다. 판독에서 "여름"이 "름"으로 깨지는 일이 잦다. */
function normSem(t){
  if(/^[1-4]$/.test(t)) return t;
  if(t.length > 3) return null;
  if(/름|하계/.test(t)) return '여름';
  if(/겨|울|을|동계/.test(t)) return '겨울';
  if(/계절/.test(t)) return '여름';
  return null;
}
const CRED  = /^\d{1,2}(\.\d)?$/;
/* 평점 열: 4.5 · .0 · P/F. 등급 글자는 판독 오류가 잦아 기준으로 쓰지 않는다. */
const SCORE = /^(0|\.\d+|\d{1,2}\.\d+|P\/F|PF)$/i;
const BORDER = /[|｜「」ㅣ│┃¦╎丨]/g;

/* 토큰 흐름에서 성적 행을 찾는다.
   년도 → 학기 → 교과목-분반 → 과목명 → 학점 → 등급 → 평점 순서만 지켜지면
   줄바꿈이 어긋나거나 등급이 깨져도 인식한다. */
function parseStream(tk){
  const out = [];
  for(let i = 0; i < tk.length - 4; i++){
    if(!/^(19|20)\d{2}$/.test(tk[i])) continue;
    const yr = +tk[i];
    if(yr < 2000 || yr > 2035) continue;   /* 판독 오류로 생기는 엉뚱한 연도 차단 */
    const sem = normSem(tk[i+1]);
    if(!sem) continue;
    let ci = -1;
    for(let k = i + 2; k < Math.min(tk.length, i + 7); k++) if(CODE.test(tk[k])){ ci = k; break; }
    if(ci === -1) continue;
    const stop = function(k){
      return /^(19|20)\d{2}$/.test(tk[k]) && k + 1 < tk.length && normSem(tk[k+1]) !== null;
    };
    /* 1순위 — 평점 열을 기준점으로 삼는다. 학점 위치까지 함께 검증된다. */
    /* 판독 과정에서 분반이 코드에서 떨어져 나오면 과목명에 섞인다 — 분리해 낸다. */
    if(tk[ci].indexOf('-') < 0 && ci + 2 < tk.length && /^[0-9A-Z]{1,3}$/i.test(tk[ci+1])) ci += 1;

    let si = -1;
    for(let k = ci + 4; k < Math.min(tk.length, ci + 13); k++){
      if(stop(k)) break;
      if(SCORE.test(tk[k]) && CRED.test(tk[k-2])){ si = k; break; }
    }
    let name, credit, score = null, grade = null, passed = true, end;
    if(si >= 0){
      name = tk.slice(ci + 1, si - 2).join(' ');
      credit = parseFloat(tk[si-2]);
      grade = tk[si-1]; score = tk[si];
      passed = /^P\/?F$/i.test(score) || parseFloat(score.charAt(0) === '.' ? '0' + score : score) > 0;
      end = si;
    }else{
      /* 2순위 — 등급·평점 열이 가려진 보관성적증명서. 코드 뒤 첫 단독 숫자를 학점으로 본다. */
      let pi = -1;
      for(let k = ci + 2; k < Math.min(tk.length, ci + 12); k++){
        if(stop(k)) break;
        if(CRED.test(tk[k])){ pi = k; break; }
      }
      if(pi === -1) continue;
      name = tk.slice(ci + 1, pi).join(' ');
      credit = parseFloat(tk[pi]);
      end = pi;
    }
    name = name.replace(/^[-–—·.]+/, '').trim();
    if(!name) continue;
    out.push({year:yr, sem:sem, name:name, credit:credit,
              grade:grade, score:score, passed:passed});
    i = end;
  }
  return out;
}
function parseText(text){
  return parseStream(String(text).replace(BORDER, ' ').split(/\s+/).filter(Boolean));
}

const PDFJS_BASE = 'https://cdn.jsdelivr.net/npm/pdfjs-dist@3.11.174/';
async function readPdf(file){
  const buf = await file.arrayBuffer();
  const doc = await window.pdfjsLib.getDocument({
    data:new Uint8Array(buf), cMapUrl:PDFJS_BASE + 'cmaps/', cMapPacked:true,
    standardFontDataUrl:PDFJS_BASE + 'standard_fonts/'
  }).promise;
  const lines = [];
  for(let p = 1; p <= doc.numPages; p++){
    const page = await doc.getPage(p);
    const tc = await page.getTextContent();
    const bucket = {};
    tc.items.forEach(function(it){
      if(!it.str) return;
      const y = Math.round(it.transform[5]);
      (bucket[y] = bucket[y] || []).push({x:it.transform[4], s:it.str});
    });
    Object.keys(bucket).map(Number).sort(function(a,b){ return b - a; }).forEach(function(y){
      const s = bucket[y].sort(function(a,b){ return a.x - b.x; })
                         .map(function(o){ return o.s; }).join('').replace(/\s+/g,' ').trim();
      if(s) lines.push(s);
    });
  }
  return lines;
}

